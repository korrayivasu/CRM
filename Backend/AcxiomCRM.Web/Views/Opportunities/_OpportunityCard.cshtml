@model AcxiomCRM.Web.Models.Entities.Opportunity

<div class="card bg-white border rounded-3 p-3 shadow-xs">
    <div class="d-flex justify-content-between align-items-start mb-2">
        <a asp-action="Details" asp-route-id="@Model.OpportunityId" class="fw-bold text-dark text-decoration-none small">
            @Model.OpportunityName
        </a>
        <div class="dropdown">
            <button class="btn btn-sm btn-link text-muted p-0" type="button" data-bs-toggle="dropdown">
                <i class="bi bi-three-dots-vertical"></i>
            </button>
            <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                <li><a class="dropdown-item small" asp-action="Edit" asp-route-id="@Model.OpportunityId"><i class="bi bi-pencil me-1"></i> Edit</a></li>
                @if (Model.Stage != OpportunityStages.Won && Model.Stage != OpportunityStages.Lost)
                {
                    <li>
                        <form asp-action="QuickStage" asp-route-id="@Model.OpportunityId" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="targetStage" value="@OpportunityStages.Won" />
                            <button type="submit" class="dropdown-item small text-success"><i class="bi bi-check-circle me-1"></i> Mark Won</button>
                        </form>
                    </li>
                    <li>
                        <form asp-action="QuickStage" asp-route-id="@Model.OpportunityId" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="targetStage" value="@OpportunityStages.Lost" />
                            <button type="submit" class="dropdown-item small text-danger"><i class="bi bi-x-circle me-1"></i> Mark Lost</button>
                        </form>
                    </li>
                }
            </ul>
        </div>
    </div>

    <div class="small text-muted mb-2">
        <i class="bi bi-building me-1"></i>@(Model.Customer?.CustomerName ?? "Customer")
    </div>

    <div class="d-flex justify-content-between align-items-center mb-2">
        <span class="fw-bold text-dark">₹@Model.Amount.ToString("N0")</span>
        <span class="badge bg-light text-secondary border small">@Model.Probability% prob</span>
    </div>

    <div class="progress mb-2" style="height: 4px;">
        <div class="progress-bar @(Model.Probability >= 70 ? "bg-success" : Model.Probability >= 40 ? "bg-warning" : "bg-info")" 
             style="width: @Model.Probability%"></div>
    </div>

    <div class="d-flex justify-content-between align-items-center small text-muted pt-1 border-top">
        <span><i class="bi bi-calendar me-1"></i>@Model.ExpectedCloseDate.ToString("MMM dd")</span>
        <span><i class="bi bi-person me-1"></i>@(Model.AssignedToUser?.FullName?.Split(' ').FirstOrDefault() ?? "Exec")</span>
    </div>
</div>
