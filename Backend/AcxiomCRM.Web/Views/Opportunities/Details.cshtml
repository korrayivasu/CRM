@model AcxiomCRM.Web.Models.Entities.Opportunity
@{
    ViewData["Title"] = "Opportunity: " + Model.OpportunityName;
    Layout = "_Layout";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <div class="d-flex align-items-center gap-2">
            <h4 class="fw-bold mb-0">@Model.OpportunityName</h4>
            <span class="badge @(Model.Status == "Won" ? "bg-success" : Model.Status == "Lost" ? "bg-danger" : "bg-primary-subtle text-primary") fs-6">
                @Model.Stage (@Model.Status)
            </span>
        </div>
        <p class="text-muted small mb-0 mt-1">Customer: <strong>@(Model.Customer?.CustomerName ?? "Unknown")</strong> &bull; Created @Model.CreatedDate.ToString("MMMM dd, yyyy")</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Edit" asp-route-id="@Model.OpportunityId" class="btn btn-primary rounded-3">
            <i class="bi bi-pencil me-1"></i> Edit Opportunity
        </a>
        <a asp-action="Index" class="btn btn-outline-secondary rounded-3">
            <i class="bi bi-arrow-left me-1"></i> Back to Pipeline
        </a>
    </div>
</div>

<div class="row g-4">
    <!-- Deal Economics Card -->
    <div class="col-lg-4">
        <div class="crm-card">
            <div class="crm-card-header">
                <h5><i class="bi bi-cash-stack me-2 text-primary"></i>Deal Financials</h5>
            </div>
            <div class="crm-card-body">
                <div class="mb-3">
                    <label class="text-muted small d-block">Contract / Deal Amount</label>
                    <div class="fw-bold text-dark fs-4">₹@Model.Amount.ToString("N2")</div>
                </div>
                <div class="mb-3">
                    <label class="text-muted small d-block">Win Probability</label>
                    <div class="fw-bold fs-5 text-primary">@Model.Probability%</div>
                    <div class="progress mt-1" style="height: 6px;">
                        <div class="progress-bar bg-primary" style="width: @Model.Probability%"></div>
                    </div>
                </div>
                <div class="mb-3">
                    <label class="text-muted small d-block">Weighted Forecast (Amount &times; Prob / 100)</label>
                    <div class="fw-bold text-success fs-5">₹@Model.WeightedAmount.ToString("N2")</div>
                </div>
                <div class="mb-3">
                    <label class="text-muted small d-block">Expected Target Close</label>
                    <div class="fw-semibold">@Model.ExpectedCloseDate.ToString("MMMM dd, yyyy")</div>
                </div>
                <hr />
                <div class="mb-2">
                    <label class="text-muted small d-block">Deal Owner</label>
                    <div class="fw-semibold"><i class="bi bi-person me-1"></i>@(Model.AssignedToUser?.FullName ?? "Unassigned")</div>
                </div>
                @if (!string.IsNullOrEmpty(Model.Notes))
                {
                    <div class="mt-3">
                        <label class="text-muted small d-block">Notes & Strategy</label>
                        <p class="small text-secondary mb-0">@Model.Notes</p>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Related Follow-Ups and Activities -->
    <div class="col-lg-8">
        <div class="crm-card mb-4">
            <div class="crm-card-header">
                <h5><i class="bi bi-calendar-check me-2 text-primary"></i>Follow-Ups on Deal</h5>
                <a asp-controller="FollowUps" asp-action="Create" asp-route-opportunityId="@Model.OpportunityId" class="btn btn-sm btn-outline-primary">
                    <i class="bi bi-plus-lg me-1"></i> Add Follow-Up
                </a>
            </div>
            <div class="crm-card-body">
                @if (ViewBag.FollowUps != null && ((List<AcxiomCRM.Web.Models.Entities.FollowUp>)ViewBag.FollowUps).Any())
                {
                    <div class="list-group list-group-flush">
                        @foreach (var fu in (List<AcxiomCRM.Web.Models.Entities.FollowUp>)ViewBag.FollowUps)
                        {
                            <div class="list-group-item px-0 py-2 d-flex justify-content-between align-items-center">
                                <div>
                                    <div class="fw-semibold">@fu.Subject</div>
                                    <small class="text-muted">
                                        @fu.FollowUpDate.ToString("yyyy-MM-dd HH:mm") &bull; @fu.FollowUpType &bull; @(fu.AssignedToUser?.FullName ?? "User")
                                    </small>
                                </div>
                                <span class="badge @(fu.Status == "Completed" ? "bg-success" : "bg-warning text-dark")">@fu.Status</span>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <p class="text-muted small text-center py-3 mb-0">No follow-ups recorded for this opportunity.</p>
                }
            </div>
        </div>
    </div>
</div>
