@model AcxiomCRM.Web.ViewModels.PipelineKanbanViewModel
@{
    ViewData["Title"] = "Sales Pipeline Board";
    Layout = "_Layout";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="fw-bold mb-1">Visual Sales Pipeline</h4>
        <p class="text-muted small mb-0">Total Open Pipeline: <strong>₹@Model.TotalPipelineValue.ToString("N2")</strong> &bull; Weighted Forecast: <strong class="text-primary">₹@Model.TotalWeightedValue.ToString("N2")</strong></p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Index" asp-route-viewMode="table" class="btn btn-outline-secondary rounded-3">
            <i class="bi bi-table me-1"></i> Table View
        </a>
        <a asp-action="Create" class="btn btn-primary rounded-3 shadow-sm">
            <i class="bi bi-plus-lg me-1"></i> New Opportunity
        </a>
    </div>
</div>

<!-- Pipeline Kanban Stage Columns -->
<div class="row g-3" style="min-height: 600px;">
    <!-- 1. Qualification Column -->
    <div class="col-lg">
        <div class="card h-100 bg-light border-0 shadow-sm rounded-3">
            <div class="card-header bg-white border-bottom py-3 rounded-top-3 d-flex justify-content-between align-items-center">
                <span class="fw-bold text-dark"><i class="bi bi-dot text-primary fs-4 align-middle"></i> Qualification</span>
                <span class="badge bg-primary-subtle text-primary">@Model.Qualification.Count</span>
            </div>
            <div class="card-body p-2 d-flex flex-column gap-2 overflow-y-auto" style="max-height: 650px;">
                @foreach (var opp in Model.Qualification)
                {
                    <partial name="_OpportunityCard" model="opp" />
                }
            </div>
        </div>
    </div>

    <!-- 2. Proposal Column -->
    <div class="col-lg">
        <div class="card h-100 bg-light border-0 shadow-sm rounded-3">
            <div class="card-header bg-white border-bottom py-3 rounded-top-3 d-flex justify-content-between align-items-center">
                <span class="fw-bold text-dark"><i class="bi bi-dot text-warning fs-4 align-middle"></i> Proposal</span>
                <span class="badge bg-warning-subtle text-warning">@Model.Proposal.Count</span>
            </div>
            <div class="card-body p-2 d-flex flex-column gap-2 overflow-y-auto" style="max-height: 650px;">
                @foreach (var opp in Model.Proposal)
                {
                    <partial name="_OpportunityCard" model="opp" />
                }
            </div>
        </div>
    </div>

    <!-- 3. Negotiation Column -->
    <div class="col-lg">
        <div class="card h-100 bg-light border-0 shadow-sm rounded-3">
            <div class="card-header bg-white border-bottom py-3 rounded-top-3 d-flex justify-content-between align-items-center">
                <span class="fw-bold text-dark"><i class="bi bi-dot text-info fs-4 align-middle"></i> Negotiation</span>
                <span class="badge bg-info-subtle text-info">@Model.Negotiation.Count</span>
            </div>
            <div class="card-body p-2 d-flex flex-column gap-2 overflow-y-auto" style="max-height: 650px;">
                @foreach (var opp in Model.Negotiation)
                {
                    <partial name="_OpportunityCard" model="opp" />
                }
            </div>
        </div>
    </div>

    <!-- 4. Won Column -->
    <div class="col-lg">
        <div class="card h-100 bg-light border-0 shadow-sm rounded-3">
            <div class="card-header bg-white border-bottom py-3 rounded-top-3 d-flex justify-content-between align-items-center">
                <span class="fw-bold text-success"><i class="bi bi-check-circle-fill text-success fs-5 align-middle me-1"></i> Won</span>
                <span class="badge bg-success text-white">@Model.Won.Count</span>
            </div>
            <div class="card-body p-2 d-flex flex-column gap-2 overflow-y-auto" style="max-height: 650px;">
                @foreach (var opp in Model.Won)
                {
                    <partial name="_OpportunityCard" model="opp" />
                }
            </div>
        </div>
    </div>

    <!-- 5. Lost Column -->
    <div class="col-lg">
        <div class="card h-100 bg-light border-0 shadow-sm rounded-3">
            <div class="card-header bg-white border-bottom py-3 rounded-top-3 d-flex justify-content-between align-items-center">
                <span class="fw-bold text-danger"><i class="bi bi-x-circle-fill text-danger fs-5 align-middle me-1"></i> Lost</span>
                <span class="badge bg-danger text-white">@Model.Lost.Count</span>
            </div>
            <div class="card-body p-2 d-flex flex-column gap-2 overflow-y-auto" style="max-height: 650px;">
                @foreach (var opp in Model.Lost)
                {
                    <partial name="_OpportunityCard" model="opp" />
                }
            </div>
        </div>
    </div>
</div>
