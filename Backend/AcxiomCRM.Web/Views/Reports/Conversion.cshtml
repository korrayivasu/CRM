@model AcxiomCRM.Web.ViewModels.ConversionReportModel
@{
    ViewData["Title"] = "Sales Conversion Report";
    Layout = "_Layout";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="fw-bold mb-1">Sales Conversion & Win/Loss Analysis</h4>
        <p class="text-muted small mb-0">Conversion efficiency from lead qualification to closed revenue</p>
    </div>
    <div class="d-flex gap-2">
        <button onclick="window.print()" class="btn btn-outline-secondary btn-sm"><i class="bi bi-printer me-1"></i> Print</button>
        <a asp-action="Index" class="btn btn-light border btn-sm">Back to Hub</a>
    </div>
</div>

<div class="row g-4 mb-4">
    <div class="col-md-6">
        <div class="crm-card p-4">
            <h5 class="fw-bold mb-3"><i class="bi bi-funnel me-2 text-primary"></i>Lead Conversion Rate</h5>
            <div class="d-flex align-items-center gap-3 mb-3">
                <div class="fs-1 fw-bold text-primary">@Model.LeadConversionRate%</div>
                <div class="small text-muted">
                    <strong>@Model.ConvertedLeads</strong> converted out of <strong>@Model.TotalLeads</strong> total leads captured.
                </div>
            </div>
            <div class="progress mb-2" style="height: 10px;">
                <div class="progress-bar bg-primary" style="width: @Model.LeadConversionRate%"></div>
            </div>
        </div>
    </div>

    <div class="col-md-6">
        <div class="crm-card p-4">
            <h5 class="fw-bold mb-3"><i class="bi bi-trophy me-2 text-success"></i>Opportunity Win Rate</h5>
            <div class="d-flex align-items-center gap-3 mb-3">
                <div class="fs-1 fw-bold text-success">@Model.OpportunityWinRate%</div>
                <div class="small text-muted">
                    <strong>@Model.WonOpps</strong> won vs <strong>@Model.LostOpps</strong> lost out of <strong>@Model.TotalClosedOpps</strong> closed opportunities.
                </div>
            </div>
            <div class="progress mb-2" style="height: 10px;">
                <div class="progress-bar bg-success" style="width: @Model.OpportunityWinRate%"></div>
            </div>
        </div>
    </div>
</div>

<div class="crm-card p-4">
    <h5 class="fw-bold mb-3"><i class="bi bi-cash-stack me-2 text-success"></i>Total Realized Closed-Won Revenue</h5>
    <h2 class="fw-bold text-success mb-0">₹@Model.TotalWonRevenue.ToString("N2")</h2>
</div>
