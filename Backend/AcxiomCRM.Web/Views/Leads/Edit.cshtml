@model AcxiomCRM.Web.ViewModels.EditLeadViewModel
@{
    ViewData["Title"] = "Edit Lead";
    Layout = "_Layout";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="crm-card">
            <div class="crm-card-header">
                <h5><i class="bi bi-pencil-square me-2 text-primary"></i>Edit Lead: @Model.LeadName (@Model.LeadCode)</h5>
                <a asp-action="Index" class="btn btn-sm btn-outline-secondary">Back to List</a>
            </div>
            <div class="crm-card-body">
                <form asp-action="Edit" method="post" id="editLeadForm">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="LeadId" />
                    <input type="hidden" asp-for="LeadCode" />
                    <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="LeadName" class="form-label"></label> <span class="text-danger">*</span>
                            <input asp-for="LeadName" class="form-control" />
                            <span asp-validation-for="LeadName" class="field-validation-error"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="CompanyName" class="form-label"></label>
                            <input asp-for="CompanyName" class="form-control" />
                            <span asp-validation-for="CompanyName" class="field-validation-error"></span>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="Email" class="form-label"></label> <span class="text-danger">*</span>
                            <input asp-for="Email" class="form-control" />
                            <span asp-validation-for="Email" class="field-validation-error"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="Phone" class="form-label"></label> <span class="text-danger">*</span>
                            <input asp-for="Phone" class="form-control" maxlength="10" />
                            <span asp-validation-for="Phone" class="field-validation-error"></span>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-4 mb-3">
                            <label asp-for="Source" class="form-label"></label> <span class="text-danger">*</span>
                            <select asp-for="Source" class="form-select">
                                <option value="Website">Website Form</option>
                                <option value="Referral">Client Referral</option>
                                <option value="Cold Call">Cold Outreach</option>
                                <option value="Social Media">LinkedIn / Social</option>
                                <option value="Partner">Channel Partner</option>
                                <option value="Event">Expo / Webinar</option>
                            </select>
                            <span asp-validation-for="Source" class="field-validation-error"></span>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label asp-for="Status" class="form-label"></label> <span class="text-danger">*</span>
                            <select asp-for="Status" class="form-select">
                                @foreach (var s in LeadStatuses.All)
                                {
                                    <option value="@s">@s</option>
                                }
                            </select>
                            <span asp-validation-for="Status" class="field-validation-error"></span>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label asp-for="Priority" class="form-label"></label>
                            <select asp-for="Priority" class="form-select">
                                <option value="High">High</option>
                                <option value="Medium">Medium</option>
                                <option value="Low">Low</option>
                            </select>
                            <span asp-validation-for="Priority" class="field-validation-error"></span>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="ExpectedValue" class="form-label"></label>
                            <div class="input-group">
                                <span class="input-group-text">₹</span>
                                <input asp-for="ExpectedValue" class="form-control" type="number" step="1000" min="0" />
                            </div>
                            <span asp-validation-for="ExpectedValue" class="field-validation-error"></span>
                        </div>

                        @if (User.IsInRole(AppRoles.Admin) || User.IsInRole(AppRoles.Manager))
                        {
                            <div class="col-md-6 mb-3">
                                <label asp-for="AssignedTo" class="form-label">Sales Executive</label>
                                <select asp-for="AssignedTo" asp-items="ViewBag.Users" class="form-select"></select>
                                <span asp-validation-for="AssignedTo" class="field-validation-error"></span>
                            </div>
                        }
                    </div>

                    <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                        <a asp-action="Index" class="btn btn-light border">Cancel</a>
                        <button type="submit" class="btn btn-primary px-4 fw-semibold">Save Changes</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
