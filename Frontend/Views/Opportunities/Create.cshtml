@model AcxiomCRM.Web.ViewModels.CreateOpportunityViewModel
@{
    ViewData["Title"] = "Create Opportunity";
    Layout = "_Layout";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="crm-card">
            <div class="crm-card-header">
                <h5><i class="bi bi-graph-up-arrow me-2 text-primary"></i>Create Sales Opportunity</h5>
                <a asp-action="Index" class="btn btn-sm btn-outline-secondary">Back to Pipeline</a>
            </div>
            <div class="crm-card-body">
                <form asp-action="Create" method="post" id="createOpportunityForm">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>

                    <div class="mb-3">
                        <label asp-for="OpportunityName" class="form-label"></label> <span class="text-danger">*</span>
                        <input asp-for="OpportunityName" class="form-control" placeholder="e.g. Enterprise Cloud Modernization" />
                        <span asp-validation-for="OpportunityName" class="field-validation-error"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="CustomerId" class="form-label"></label> <span class="text-danger">*</span>
                        <select asp-for="CustomerId" asp-items="ViewBag.Customers" class="form-select">
                            <option value="">-- Select Customer Account --</option>
                        </select>
                        <span asp-validation-for="CustomerId" class="field-validation-error"></span>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="Amount" class="form-label"></label> <span class="text-danger">*</span>
                            <div class="input-group">
                                <span class="input-group-text">₹</span>
                                <input asp-for="Amount" class="form-control" type="number" step="0.01" min="0.01" placeholder="Amount > 0" />
                            </div>
                            <span asp-validation-for="Amount" class="field-validation-error"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="Stage" class="form-label"></label> <span class="text-danger">*</span>
                            <select asp-for="Stage" class="form-select">
                                @foreach (var s in OpportunityStages.All)
                                {
                                    <option value="@s">@s</option>
                                }
                            </select>
                            <span asp-validation-for="Stage" class="field-validation-error"></span>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="Probability" class="form-label"></label> (%) <span class="text-danger">*</span>
                            <input asp-for="Probability" class="form-control" type="number" min="0" max="100" />
                            <span asp-validation-for="Probability" class="field-validation-error"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="ExpectedCloseDate" class="form-label"></label> <span class="text-danger">*</span>
                            <input asp-for="ExpectedCloseDate" class="form-control" type="date" min="@DateTime.UtcNow.ToString("yyyy-MM-dd")" />
                            <span asp-validation-for="ExpectedCloseDate" class="field-validation-error"></span>
                        </div>
                    </div>

                    @if (User.IsInRole(AppRoles.Admin) || User.IsInRole(AppRoles.Manager))
                    {
                        <div class="mb-3">
                            <label asp-for="AssignedTo" class="form-label"></label>
                            <select asp-for="AssignedTo" asp-items="ViewBag.Users" class="form-select">
                                <option value="">-- Assign to myself --</option>
                            </select>
                            <span asp-validation-for="AssignedTo" class="field-validation-error"></span>
                        </div>
                    }

                    <div class="mb-3">
                        <label asp-for="Notes" class="form-label"></label>
                        <textarea asp-for="Notes" class="form-control" rows="3" placeholder="Key deal dynamics, next steps, executive contacts..."></textarea>
                        <span asp-validation-for="Notes" class="field-validation-error"></span>
                    </div>

                    <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                        <a asp-action="Index" class="btn btn-light border">Cancel</a>
                        <button type="submit" class="btn btn-primary px-4 fw-semibold">Save Opportunity</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
