@model IEnumerable<AcxiomCRM.Web.Models.Entities.AuditLog>
@{
    ViewData["Title"] = "Security Audit Report";
    Layout = "_Layout";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="fw-bold mb-1">Security & System Audit Report</h4>
        <p class="text-muted small mb-0">Confidential append-only compliance log for system administrators</p>
    </div>
    <div class="d-flex gap-2">
        <button onclick="window.print()" class="btn btn-outline-secondary btn-sm"><i class="bi bi-printer me-1"></i> Print</button>
        <a asp-action="Index" class="btn btn-light border btn-sm">Back to Hub</a>
    </div>
</div>

<div class="crm-card">
    <div class="table-responsive">
        <table class="table crm-table align-middle">
            <thead>
                <tr>
                    <th>Timestamp (UTC)</th>
                    <th>User</th>
                    <th>Action</th>
                    <th>Entity</th>
                    <th>Record ID</th>
                    <th>Result</th>
                    <th>IP Address</th>
                    <th>Details</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var log in Model)
                {
                    <tr>
                        <td class="small text-muted">@log.CreatedDate.ToString("yyyy-MM-dd HH:mm:ss")</td>
                        <td class="fw-bold"><i class="bi bi-person me-1"></i>@(log.UserName ?? "System")</td>
                        <td><span class="badge bg-light text-dark border">@log.Action</span></td>
                        <td>@log.EntityName</td>
                        <td><code>@(log.RecordId ?? "-")</code></td>
                        <td><span class="badge @(log.Result == "Success" ? "bg-success" : "bg-danger")">@log.Result</span></td>
                        <td class="small text-muted">@log.IpAddress</td>
                        <td class="small text-truncate" style="max-width: 300px;">@log.Details</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
