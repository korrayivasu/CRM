@{
    ViewData["Title"] = "Access Denied";
    Layout = "_Layout";
}

<div class="container py-5 text-center" style="max-width: 600px;">
    <div class="card border-0 shadow-sm rounded-4 p-5">
        <div class="text-danger mb-3" style="font-size: 3.5rem;">
            <i class="bi bi-shield-slash-fill"></i>
        </div>
        <h2 class="fw-bold text-dark">Access Denied</h2>
        <p class="text-muted mt-2">
            You do not have the required role privileges to access this CRM resource. Authorization is strictly enforced on the server.
        </p>
        <div class="mt-4">
            <a asp-controller="Dashboard" asp-action="Index" class="btn btn-primary rounded-pill px-4">
                <i class="bi bi-house-door me-1"></i> Return to Dashboard
            </a>
        </div>
    </div>
</div>
