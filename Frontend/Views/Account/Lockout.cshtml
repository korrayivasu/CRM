@{
    ViewData["Title"] = "Account Locked Out";
    Layout = "_Layout";
}

<div class="min-vh-100 d-flex align-items-center justify-content-center py-5" style="background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%);">
    <div class="container text-center" style="max-width: 500px;">
        <div class="card border-0 shadow-lg rounded-4 p-5">
            <div class="text-warning mb-3" style="font-size: 3.5rem;">
                <i class="bi bi-lock-fill"></i>
            </div>
            <h2 class="fw-bold text-dark">Account Locked</h2>
            <p class="text-muted mt-2">
                This account has been temporarily locked out due to multiple consecutive failed login attempts, conforming to our security policy (Section 6.3).
            </p>
            <p class="small text-secondary">
                Please wait 15 minutes before trying again or contact an Administrator to unlock your account.
            </p>
            <div class="mt-4">
                <a asp-action="Login" class="btn btn-outline-secondary rounded-pill px-4">
                    <i class="bi bi-arrow-left me-1"></i> Back to Login
                </a>
            </div>
        </div>
    </div>
</div>
