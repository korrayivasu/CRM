@model AcxiomCRM.Web.ViewModels.CreateActivityViewModel
@{
    ViewData["Title"] = "Log Activity";
    Layout = "_Layout";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="crm-card">
            <div class="crm-card-header">
                <h5><i class="bi bi-clock-history me-2 text-primary"></i>Log Client Interaction / Activity</h5>
                <a asp-action="Index" class="btn btn-sm btn-outline-secondary">Back to Activities</a>
            </div>
            <div class="crm-card-body">
                <form asp-action="Create" method="post" id="createActivityForm">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="ActivityType" class="form-label"></label> <span class="text-danger">*</span>
                            <select asp-for="ActivityType" class="form-select">
                                <option value="@ActivityTypes.Call">Call</option>
                                <option value="@ActivityTypes.Meeting">Meeting</option>
                                <option value="@ActivityTypes.Email">Email</option>
                                <option value="@ActivityTypes.Task">Task</option>
                            </select>
                            <span asp-validation-for="ActivityType" class="field-validation-error"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="ActivityDate" class="form-label"></label> <span class="text-danger">*</span>
                            <input asp-for="ActivityDate" class="form-control" type="datetime-local" />
                            <span asp-validation-for="ActivityDate" class="field-validation-error"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Subject" class="form-label"></label> <span class="text-danger">*</span>
                        <input asp-for="Subject" class="form-control" placeholder="e.g. Discussed pricing discounts with VP Finance" />
                        <span asp-validation-for="Subject" class="field-validation-error"></span>
                    </div>

                    <div class="row">
                        <div class="col-md-4 mb-3">
                            <label asp-for="CustomerId" class="form-label"></label>
                            <select asp-for="CustomerId" asp-items="ViewBag.Customers" class="form-select">
                                <option value="">-- None / N/A --</option>
                            </select>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label asp-for="LeadId" class="form-label"></label>
                            <select asp-for="LeadId" asp-items="ViewBag.Leads" class="form-select">
                                <option value="">-- None / N/A --</option>
                            </select>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label asp-for="OpportunityId" class="form-label"></label>
                            <select asp-for="OpportunityId" asp-items="ViewBag.Opportunities" class="form-select">
                                <option value="">-- None / N/A --</option>
                            </select>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="Status" class="form-label"></label>
                            <select asp-for="Status" class="form-select">
                                <option value="Completed">Completed</option>
                                <option value="Pending">Pending</option>
                                <option value="Cancelled">Cancelled</option>
                            </select>
                            <span asp-validation-for="Status" class="field-validation-error"></span>
                        </div>

                        @if (User.IsInRole(AppRoles.Admin) || User.IsInRole(AppRoles.Manager))
                        {
                            <div class="col-md-6 mb-3">
                                <label asp-for="AssignedTo" class="form-label"></label>
                                <select asp-for="AssignedTo" asp-items="ViewBag.Users" class="form-select">
                                    <option value="">-- Assign to myself --</option>
                                </select>
                            </div>
                        }
                    </div>

                    <div class="mb-3">
                        <label asp-for="Description" class="form-label"></label>
                        <textarea asp-for="Description" class="form-control" rows="3" placeholder="Meeting minutes, conversation points, client concerns..."></textarea>
                        <span asp-validation-for="Description" class="field-validation-error"></span>
                    </div>

                    <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                        <a asp-action="Index" class="btn btn-light border">Cancel</a>
                        <button type="submit" class="btn btn-primary px-4 fw-semibold">Save Activity</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
