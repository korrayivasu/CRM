@model AcxiomCRM.Web.Models.Entities.Lead
@{
    ViewData["Title"] = "Lead Profile: " + Model.LeadName;
    Layout = "_Layout";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <div class="d-flex align-items-center gap-2">
            <span class="badge bg-light text-dark border fw-bold fs-6">@Model.LeadCode</span>
            <h4 class="fw-bold mb-0">@Model.LeadName</h4>
            @if (Model.Status == LeadStatuses.Converted)
            {
                <span class="badge badge-status-converted fs-6"><i class="bi bi-check-circle-fill me-1"></i> Converted</span>
            }
            else
            {
                <span class="badge bg-primary-subtle text-primary fs-6">@Model.Status</span>
            }
        </div>
        <p class="text-muted small mb-0 mt-1">Lead captured on @Model.CreatedDate.ToString("MMMM dd, yyyy")</p>
    </div>
    <div class="d-flex gap-2">
        @if (Model.Status != LeadStatuses.Converted)
        {
            <a asp-action="Convert" asp-route-id="@Model.LeadId" class="btn btn-success rounded-3 shadow-sm">
                <i class="bi bi-arrow-repeat me-1"></i> Convert to Customer
            </a>
        }
        <a asp-action="Edit" asp-route-id="@Model.LeadId" class="btn btn-primary rounded-3">
            <i class="bi bi-pencil me-1"></i> Edit Lead
        </a>
        <a asp-action="Index" class="btn btn-outline-secondary rounded-3">
            <i class="bi bi-arrow-left me-1"></i> Back to Leads
        </a>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-4">
        <!-- Lead Profile Card -->
        <div class="crm-card">
            <div class="crm-card-header">
                <h5><i class="bi bi-funnel me-2 text-primary"></i>Lead Information</h5>
            </div>
            <div class="crm-card-body">
                <div class="mb-3">
                    <label class="text-muted small d-block">Company</label>
                    <div class="fw-semibold">@(Model.CompanyName ?? "-")</div>
                </div>
                <div class="mb-3">
                    <label class="text-muted small d-block">Email</label>
                    <div><a href="mailto:@Model.Email">@Model.Email</a></div>
                </div>
                <div class="mb-3">
                    <label class="text-muted small d-block">Phone</label>
                    <div class="fw-semibold">@Model.Phone</div>
                </div>
                <div class="mb-3">
                    <label class="text-muted small d-block">Lead Source</label>
                    <span class="badge bg-light text-dark border">@Model.Source</span>
                </div>
                <div class="mb-3">
                    <label class="text-muted small d-block">Priority</label>
                    <span class="badge @(Model.Priority == "High" ? "bg-danger-subtle text-danger" : "bg-warning-subtle text-warning")">
                        @Model.Priority
                    </span>
                </div>
                <div class="mb-3">
                    <label class="text-muted small d-block">Expected Value</label>
                    <div class="fw-bold text-success fs-5">₹@Model.ExpectedValue.ToString("N2")</div>
                </div>
                <hr />
                <div class="mb-2">
                    <label class="text-muted small d-block">Assigned Sales Executive</label>
                    <div class="fw-semibold"><i class="bi bi-person me-1"></i>@(Model.AssignedToUser?.FullName ?? "Unassigned")</div>
                </div>

                @if (Model.ConvertedCustomerId.HasValue)
                {
                    <div class="mt-3 p-3 bg-success bg-opacity-10 rounded-3 border border-success-subtle">
                        <div class="small fw-bold text-success"><i class="bi bi-check-circle me-1"></i> Converted Customer</div>
                        <div class="mt-1">
                            <a asp-controller="Customers" asp-action="Details" asp-route-id="@Model.ConvertedCustomerId.Value" class="text-success fw-bold text-decoration-none">
                                View Customer Profile &rarr;
                            </a>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Related Follow-Ups and Activities -->
    <div class="col-lg-8">
        <div class="crm-card mb-4">
            <div class="crm-card-header">
                <h5><i class="bi bi-calendar-check me-2 text-primary"></i>Scheduled Follow-Ups</h5>
                <a asp-controller="FollowUps" asp-action="Create" asp-route-leadId="@Model.LeadId" class="btn btn-sm btn-outline-primary">
                    <i class="bi bi-plus-lg me-1"></i> Add Follow-Up
                </a>
            </div>
            <div class="crm-card-body">
                @if (ViewBag.FollowUps != null && ((List<AcxiomCRM.Web.Models.Entities.FollowUp>)ViewBag.FollowUps).Any())
                {
                    <div class="list-group list-group-flush">
                        @foreach (var fu in (List<AcxiomCRM.Web.Models.Entities.FollowUp>)ViewBag.FollowUps)
                        {
                            <div class="list-group-item px-0 py-2 d-flex justify-content-between align-items-center">
                                <div>
                                    <div class="fw-semibold">@fu.Subject</div>
                                    <small class="text-muted">
                                        @fu.FollowUpDate.ToString("yyyy-MM-dd HH:mm") &bull; @fu.FollowUpType &bull; @(fu.AssignedToUser?.FullName ?? "User")
                                    </small>
                                    @if (!string.IsNullOrEmpty(fu.Remarks))
                                    {
                                        <div class="small text-secondary mt-1">@fu.Remarks</div>
                                    }
                                </div>
                                <span class="badge @(fu.Status == "Completed" ? "bg-success" : "bg-warning text-dark")">@fu.Status</span>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <p class="text-muted small text-center py-3 mb-0">No follow-ups recorded for this lead.</p>
                }
            </div>
        </div>
    </div>
</div>
