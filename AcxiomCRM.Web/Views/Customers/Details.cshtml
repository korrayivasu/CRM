@model AcxiomCRM.Web.ViewModels.CustomerDetailsViewModel
@{
    ViewData["Title"] = "Customer Profile: " + Model.Customer.CustomerName;
    Layout = "_Layout";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <div class="d-flex align-items-center gap-2">
            <span class="badge bg-light text-dark border fw-bold fs-6">@Model.Customer.CustomerCode</span>
            <h4 class="fw-bold mb-0">@Model.Customer.CustomerName</h4>
            @if (Model.Customer.Status == CustomerStatuses.Active)
            {
                <span class="badge bg-success-subtle text-success">Active</span>
            }
            else
            {
                <span class="badge bg-danger-subtle text-danger">@Model.Customer.Status</span>
            }
        </div>
        <p class="text-muted small mb-0 mt-1">Customer since @Model.Customer.CreatedDate.ToString("MMMM dd, yyyy")</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Edit" asp-route-id="@Model.Customer.CustomerId" class="btn btn-primary rounded-3">
            <i class="bi bi-pencil me-1"></i> Edit Customer
        </a>
        <a asp-action="Index" class="btn btn-outline-secondary rounded-3">
            <i class="bi bi-arrow-left me-1"></i> Back to Accounts
        </a>
    </div>
</div>

<div class="row g-4">
    <!-- Left Column: Master Data Profile Card -->
    <div class="col-lg-4">
        <div class="crm-card">
            <div class="crm-card-header">
                <h5><i class="bi bi-person-vcard me-2 text-primary"></i>Profile Details</h5>
            </div>
            <div class="crm-card-body">
                <div class="mb-3">
                    <label class="text-muted small d-block">Company / Organization</label>
                    <div class="fw-semibold">@(Model.Customer.CompanyName ?? "-")</div>
                </div>
                <div class="mb-3">
                    <label class="text-muted small d-block">Primary Email</label>
                    <div><a href="mailto:@Model.Customer.Email" class="text-decoration-none">@Model.Customer.Email</a></div>
                </div>
                <div class="mb-3">
                    <label class="text-muted small d-block">Phone Number</label>
                    <div class="fw-semibold">@Model.Customer.Phone</div>
                </div>
                <div class="mb-3">
                    <label class="text-muted small d-block">Location / Address</label>
                    <div>@(Model.Customer.Address ?? "Not specified")</div>
                    <div class="small text-muted">@Model.Customer.City, @Model.Customer.State</div>
                </div>
                <hr />
                <div class="mb-2">
                    <label class="text-muted small d-block">Account Owner</label>
                    <div class="fw-semibold"><i class="bi bi-person me-1"></i>@(Model.Customer.CreatedByUser?.FullName ?? "System")</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Right Column: Tabs for Related Opportunities, Follow-ups, Activities -->
    <div class="col-lg-8">
        <div class="crm-card">
            <div class="crm-card-header border-bottom-0 pb-0">
                <ul class="nav nav-tabs card-header-tabs" id="customerTabs" role="tablist">
                    <li class="nav-item" role="presentation">
                        <button class="nav-link active" id="opps-tab" data-bs-toggle="tab" data-bs-target="#opps" type="button" role="tab">
                            <i class="bi bi-graph-up me-1"></i> Opportunities (@Model.Opportunities.Count)
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link" id="followups-tab" data-bs-toggle="tab" data-bs-target="#followups" type="button" role="tab">
                            <i class="bi bi-calendar-check me-1"></i> Follow-Ups (@Model.FollowUps.Count)
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link" id="activities-tab" data-bs-toggle="tab" data-bs-target="#activities" type="button" role="tab">
                            <i class="bi bi-clock-history me-1"></i> Activities (@Model.Activities.Count)
                        </button>
                    </li>
                </ul>
            </div>
            <div class="crm-card-body">
                <div class="tab-content" id="customerTabsContent">
                    <!-- Opportunities Tab -->
                    <div class="tab-pane fade show active" id="opps" role="tabpanel">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <h6 class="fw-bold mb-0">Sales Opportunities</h6>
                            <a asp-controller="Opportunities" asp-action="Create" asp-route-customerId="@Model.Customer.CustomerId" class="btn btn-sm btn-outline-primary">
                                <i class="bi bi-plus-lg me-1"></i> Add Opportunity
                            </a>
                        </div>
                        @if (Model.Opportunities.Any())
                        {
                            <div class="table-responsive">
                                <table class="table crm-table align-middle">
                                    <thead>
                                        <tr>
                                            <th>Opportunity</th>
                                            <th>Amount</th>
                                            <th>Stage</th>
                                            <th>Probability</th>
                                            <th>Expected Close</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var opp in Model.Opportunities)
                                        {
                                            <tr>
                                                <td class="fw-semibold">@opp.OpportunityName</td>
                                                <td class="fw-bold text-success">₹@opp.Amount.ToString("N2")</td>
                                                <td><span class="badge bg-primary-subtle text-primary">@opp.Stage</span></td>
                                                <td>@opp.Probability%</td>
                                                <td class="small text-muted">@opp.ExpectedCloseDate.ToString("yyyy-MM-dd")</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        else
                        {
                            <p class="text-muted small text-center py-3">No active opportunities linked to this account.</p>
                        }
                    </div>

                    <!-- Follow-ups Tab -->
                    <div class="tab-pane fade" id="followups" role="tabpanel">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <h6 class="fw-bold mb-0">Scheduled Follow-Ups</h6>
                            <a asp-controller="FollowUps" asp-action="Create" asp-route-customerId="@Model.Customer.CustomerId" class="btn btn-sm btn-outline-primary">
                                <i class="bi bi-plus-lg me-1"></i> Schedule Follow-Up
                            </a>
                        </div>
                        @if (Model.FollowUps.Any())
                        {
                            <div class="list-group list-group-flush">
                                @foreach (var fu in Model.FollowUps)
                                {
                                    <div class="list-group-item px-0 py-2 d-flex justify-content-between align-items-center">
                                        <div>
                                            <div class="fw-semibold">@fu.Subject</div>
                                            <small class="text-muted">
                                                <i class="bi bi-calendar me-1"></i>@fu.FollowUpDate.ToString("yyyy-MM-dd HH:mm") &bull; @fu.FollowUpType &bull; Assigned: @(fu.AssignedToUser?.FullName ?? "N/A")
                                            </small>
                                            @if (!string.IsNullOrEmpty(fu.Remarks))
                                            {
                                                <div class="small text-secondary mt-1">@fu.Remarks</div>
                                            }
                                        </div>
                                        <span class="badge @(fu.Status == "Completed" ? "bg-success" : fu.Status == "Missed" ? "bg-danger" : "bg-warning text-dark")">
                                            @fu.Status
                                        </span>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <p class="text-muted small text-center py-3">No follow-ups recorded.</p>
                        }
                    </div>

                    <!-- Activities Tab -->
                    <div class="tab-pane fade" id="activities" role="tabpanel">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <h6 class="fw-bold mb-0">Activity History</h6>
                            <a asp-controller="Activities" asp-action="Create" asp-route-customerId="@Model.Customer.CustomerId" class="btn btn-sm btn-outline-primary">
                                <i class="bi bi-plus-lg me-1"></i> Log Activity
                            </a>
                        </div>
                        @if (Model.Activities.Any())
                        {
                            <div class="list-group list-group-flush">
                                @foreach (var act in Model.Activities)
                                {
                                    <div class="list-group-item px-0 py-2">
                                        <div class="d-flex justify-content-between">
                                            <span class="fw-semibold"><i class="bi bi-clock me-1 text-primary"></i>@act.Subject</span>
                                            <span class="badge bg-light text-dark border">@act.ActivityType</span>
                                        </div>
                                        <div class="small text-secondary mt-1">@act.Description</div>
                                        <div class="small text-muted mt-1">@act.ActivityDate.ToString("yyyy-MM-dd HH:mm") by @(act.AssignedToUser?.FullName ?? "User")</div>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <p class="text-muted small text-center py-3">No activities recorded yet.</p>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
