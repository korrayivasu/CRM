@model AcxiomCRM.Web.ViewModels.CreateCustomerViewModel
@{
    ViewData["Title"] = "Create New Customer";
    Layout = "_Layout";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="crm-card">
            <div class="crm-card-header">
                <h5><i class="bi bi-person-plus me-2 text-primary"></i>Create Customer Record</h5>
                <a asp-action="Index" class="btn btn-sm btn-outline-secondary">Back to List</a>
            </div>
            <div class="crm-card-body">
                <form asp-action="Create" method="post" id="createCustomerForm">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>

                    <div class="row">
                        <div class="col-md-12 mb-3">
                            <label asp-for="CustomerName" class="form-label"></label> <span class="text-danger">*</span>
                            <input asp-for="CustomerName" class="form-control" placeholder="e.g. Acme Corporation Pvt Ltd" />
                            <span asp-validation-for="CustomerName" class="field-validation-error"></span>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="Email" class="form-label"></label> <span class="text-danger">*</span>
                            <input asp-for="Email" class="form-control" placeholder="contact@acme.com" />
                            <span asp-validation-for="Email" class="field-validation-error"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="Phone" class="form-label"></label> <span class="text-danger">*</span>
                            <input asp-for="Phone" class="form-control" placeholder="9876543210 (10-digit mobile)" maxlength="10" />
                            <span asp-validation-for="Phone" class="field-validation-error"></span>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="CompanyName" class="form-label"></label>
                            <input asp-for="CompanyName" class="form-control" placeholder="Acme Corp" />
                            <span asp-validation-for="CompanyName" class="field-validation-error"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="Status" class="form-label"></label>
                            <select asp-for="Status" class="form-select">
                                <option value="@CustomerStatuses.Active">Active</option>
                                <option value="@CustomerStatuses.Inactive">Inactive</option>
                                <option value="@CustomerStatuses.Prospect">Prospect</option>
                            </select>
                            <span asp-validation-for="Status" class="field-validation-error"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Address" class="form-label"></label>
                        <input asp-for="Address" class="form-control" placeholder="Street Address / Suite / Building" />
                        <span asp-validation-for="Address" class="field-validation-error"></span>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="City" class="form-label"></label>
                            <input asp-for="City" class="form-control" placeholder="City" />
                            <span asp-validation-for="City" class="field-validation-error"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="State" class="form-label"></label>
                            <input asp-for="State" class="form-control" placeholder="State / Province" />
                            <span asp-validation-for="State" class="field-validation-error"></span>
                        </div>
                    </div>

                    @if (User.IsInRole(AppRoles.Admin) || User.IsInRole(AppRoles.Manager))
                    {
                        <div class="mb-3">
                            <label asp-for="AssignedOwnerId" class="form-label"></label>
                            <select asp-for="AssignedOwnerId" asp-items="ViewBag.Users" class="form-select">
                                <option value="">-- Assign to myself --</option>
                            </select>
                            <span asp-validation-for="AssignedOwnerId" class="field-validation-error"></span>
                        </div>
                    }

                    <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                        <a asp-action="Index" class="btn btn-light border">Cancel</a>
                        <button type="submit" class="btn btn-primary px-4 fw-semibold">Save Customer</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
