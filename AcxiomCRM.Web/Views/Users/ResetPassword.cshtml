@model AcxiomCRM.Web.ViewModels.ResetPasswordViewModel
@{
    ViewData["Title"] = "Reset User Password";
    Layout = "_Layout";
}

<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="crm-card">
            <div class="crm-card-header">
                <h5><i class="bi bi-key me-2 text-warning"></i>Reset Password for: @Model.UserEmail</h5>
                <a asp-action="Index" class="btn btn-sm btn-outline-secondary">Back to List</a>
            </div>
            <div class="crm-card-body">
                <div class="alert alert-info small mb-3">
                    <i class="bi bi-info-circle me-1"></i> As an administrator, setting a new password here immediately updates the user's password hash in ASP.NET Core Identity. The password will not be stored in plain text or written into audit logs.
                </div>

                <form asp-action="ResetPassword" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="UserId" />
                    <input type="hidden" asp-for="UserEmail" />
                    <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>

                    <div class="mb-3">
                        <label asp-for="NewPassword" class="form-label">New Password</label>
                        <input asp-for="NewPassword" class="form-control" placeholder="Min 8 chars, uppercase, lowercase, number, symbol" />
                        <span asp-validation-for="NewPassword" class="field-validation-error"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="ConfirmPassword" class="form-label">Confirm New Password</label>
                        <input asp-for="ConfirmPassword" class="form-control" placeholder="Repeat new password" />
                        <span asp-validation-for="ConfirmPassword" class="field-validation-error"></span>
                    </div>

                    <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                        <a asp-action="Index" class="btn btn-light border">Cancel</a>
                        <button type="submit" class="btn btn-warning px-4 fw-semibold">Reset Password</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
